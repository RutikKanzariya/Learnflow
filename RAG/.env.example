# Groq API key - used for all LLM generation (chat, roadmap, quiz, flashcards)
GROQ_API_KEY=your-groq-api-key

# Model used for text generation (OpenAI-compatible endpoint on api.groq.com)
GROQ_MODEL=openai/gpt-oss-120b

# Groq API base URL (OpenAI-compatible)
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Embedding provider:
#   "local" -> local sentence-transformers model (no external API needed, recommended for dev)
#   "onnx"  -> ChromaDB bundled ONNX MiniLM (same model, no PyTorch, tiny memory - use on Render)
#   "openai" -> use an OpenAI-compatible embeddings endpoint (requires EMBEDDINGS_BASE_URL)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Comma-separated list of browser origins allowed to call this service
ALLOWED_ORIGINS=http://localhost:5173

# Where the ChromaDB vector store is persisted.
# Use an absolute path (e.g. a Render disk mount) in production.
CHROMA_DB_DIR=chroma-db

# Base name of the Chroma collection used for uploaded documents
# (automatically namespaced per embedding model).
CHROMA_COLLECTION=learnflow_docs