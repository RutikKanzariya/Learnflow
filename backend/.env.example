# Server port (Render sets this automatically)
PORT=5000

# MongoDB connection string (use MongoDB Atlas for production)
MONGO_URI=mongodb://localhost:27017/learnflow

# Secret used to sign JWTs
JWT_SECRET=change-me

# Allowed frontend origins (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173

# URL of the RAG / FastAPI service
AI_SERVICE_URL=http://localhost:8000